{
  "benchmark": "rmtbench",
  "protocol_label": "rmtbench-glm51-deepinfra-judge-glm53flash-v1",
  "languages": ["en", "zh"],
  "version": "claude45",
  "layout": "mixed_four_blocks",
  "repeats": 2,
  "seed": 42,
  "limit_cases": null,
  "concurrency": 4,
  "max_attempts": 3,
  "timeout_seconds": 180,
  "max_requests_per_run": 100,
  "roles": {
    "actor": {
      "model": "zai-org/GLM-5.1",
      "revision": "RECORD_PROVIDER_MODEL_REVISION_OR_DATE",
      "base_url_env": "ACTOR_BASE_URL",
      "api_key_env": "ACTOR_API_KEY",
      "sampling": {"temperature": 0.7, "max_tokens": 8192, "chat_template_kwargs": {"enable_thinking": false}}
    },
    "judge": {
      "model": "zai-org/GLM-5.3-Flash",
      "revision": "RECORD_PROVIDER_MODEL_REVISION_OR_DATE",
      "base_url_env": "JUDGE_BASE_URL",
      "api_key_env": "JUDGE_API_KEY",
      "sampling": {"temperature": 0, "max_tokens": 2048, "chat_template_kwargs": {"enable_thinking": false}}
    }
  }
}

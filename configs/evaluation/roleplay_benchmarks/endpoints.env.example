# Copy to .local/evaluation.env. Never commit real keys.
# OpenAI-compatible base URL, ending in /v1 (not /chat/completions).
EVAL_ACTOR_BASE_URL=http://127.0.0.1:8000/v1
EVAL_ACTOR_API_KEY=EMPTY
EVAL_JUDGE_BASE_URL=https://api.deepinfra.com/v1/openai
EVAL_JUDGE_API_KEY=
# Only needed to download gated benchmark data, using your own authorized account.
HF_TOKEN=

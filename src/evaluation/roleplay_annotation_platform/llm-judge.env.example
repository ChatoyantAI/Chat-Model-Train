# Copy needed settings into a server-only .env (mode 0600). Empty keys disable gateways.
OPENROUTER_API_KEY=
TATUCLOUD_API_KEY=
ROLEPLAY_TATU_URL=https://maas.tatucloud.com/v1/chat/completions
ROLEPLAY_TATU_MODELS_URL=https://maas.tatucloud.com/v1/models
ROLEPLAY_TATU_REQUEST_TIMEOUT_SECONDS=600

# Server-side public model catalog; the browser never receives the key.
ROLEPLAY_LLM_MODEL_SOURCE=openrouter
ROLEPLAY_LLM_MODEL_MIN_CONTEXT_LENGTH=0
ROLEPLAY_LLM_MODEL_CATALOG_TIMEOUT_SECONDS=15
ROLEPLAY_LLM_REASONING_EFFORT=low

# Override only selected models; others retain their code-defined defaults.
# GLM models are pinned to the configured provider pool.
ROLEPLAY_LLM_PROVIDER_ORDER=
ROLEPLAY_LLM_PROVIDER_ORDER_BY_MODEL_JSON={"z-ai/glm-5.3":["cloudflare"],"z-ai/glm-5.3-flash":["cloudflare"]}
ROLEPLAY_LLM_ALLOW_PROVIDER_FALLBACKS=true
ROLEPLAY_LLM_PROVIDER_IGNORE=alibaba,morph
ROLEPLAY_LLM_EXCLUDED_OPENROUTER_MODEL_PREFIXES=qwen/
ROLEPLAY_LLM_PROVIDER_IGNORE_BY_MODEL_JSON={}

# Fallback catalog. Use model_source=static to use only this list.
ROLEPLAY_LLM_MODELS=z-ai/glm-5.3-flash,z-ai/glm-5.3

# One Web worker. All ordinary Judge / Compare / Battle jobs share this pool.
ROLEPLAY_LLM_MAX_CONCURRENCY=64
ROLEPLAY_LLM_MAX_JOB_SAMPLES=50000
ROLEPLAY_LLM_MAX_JOB_BUDGET_USD=100
ROLEPLAY_LLM_REQUEST_TIMEOUT_SECONDS=180
ROLEPLAY_LLM_RATE_LIMIT_MAX_ATTEMPTS=4
ROLEPLAY_LLM_RATE_LIMIT_BACKOFF_SECONDS=5
ROLEPLAY_LLM_RATE_LIMIT_BACKOFF_MAX_SECONDS=60

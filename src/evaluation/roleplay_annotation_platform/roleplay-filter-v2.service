[Unit]
Description=Roleplay evaluation (filter-v2)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/roleplay-evaluation
EnvironmentFile=%h/roleplay-evaluation/configs/evaluation/filter-v2.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/roleplay-evaluation/.venv/bin/python -m uvicorn src.evaluation.roleplay_annotation_platform.filter_v2_app:app --host 0.0.0.0 --port 8767 --workers 1
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=default.target

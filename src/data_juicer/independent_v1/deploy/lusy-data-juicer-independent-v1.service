[Unit]
Description=Lusy v2.2 Data-Juicer independent_v1 full CPU audit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gyr
Group=gyr
WorkingDirectory=/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/02_data_juicer/01_independent_v1
Environment=SOURCE_DIR=/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/01_constructed/dialogues
Environment=SOURCE_MANIFEST=/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/01_constructed/CONSTRUCTION_MANIFEST.json
Environment=RUN_ROOT=/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/02_data_juicer/01_independent_v1
Environment=DJ_ROOT=/home/gyr/services/data-juicer
Environment=TOKENIZER_MODEL=/home/gyr/lusychat-training/data_juicer_smoke_v1/models/xlm-roberta-base-sentencepiece.bpe.model
Environment=DERIVE_WORKERS=8
Environment=HF_HOME=/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/02_data_juicer/01_independent_v1/00_input_manifest/hf_home
ExecStart=/home/gyr/lusychat-training/data_juicer_independent_v1/run_full.sh
ReadOnlyPaths=/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/01_constructed
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0022
LimitNOFILE=1048576
Restart=on-failure
RestartSec=60
StandardOutput=append:/home/gyr/lusychat-training/data-juicer-dialogue-v2.2-20260816/02_data_juicer/01_independent_v1/pipeline.log
StandardError=inherit

[Install]
WantedBy=multi-user.target

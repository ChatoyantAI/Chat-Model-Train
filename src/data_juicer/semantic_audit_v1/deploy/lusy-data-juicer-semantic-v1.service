[Unit]
Description=Lusy v2.2 turn-level BGE-M3 semantic embedding v1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gyr
Group=gyr
WorkingDirectory=/home/gyr/lusychat-training/data_juicer_semantic_audit_v1
Environment=CUDA_VISIBLE_DEVICES=6
Environment=HF_ENDPOINT=https://hf-mirror.com
Environment=HF_HUB_DISABLE_XET=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTORCH_ALLOC_CONF=expandable_segments:True
Environment=OMP_NUM_THREADS=8
Environment=MAX_LENGTH=512
Environment=BATCH_SIZE=16
Environment=DERIVE_WORKERS=8
ExecStart=/home/gyr/lusychat-training/data_juicer_semantic_audit_v1/run_full.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target

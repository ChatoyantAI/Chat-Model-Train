* text=auto

# Repository text formats use LF, especially files executed on Linux trainers.
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Frozen production prompt resources preserve source whitespace byte-for-byte.
src/evaluation/roleplay_judge_dataset/templates/*.txt text eol=lf whitespace=-blank-at-eol,-blank-at-eof

# Native Windows entrypoints retain CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary formats must never be normalized as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.parquet binary
*.arrow binary
*.safetensors binary
*.pt binary
*.pth binary
